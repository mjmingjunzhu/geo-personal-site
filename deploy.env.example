# ============================================================================
# 部署上线的配置模板（npm run deploy / 双击「一键上线.bat」时使用）
# ============================================================================
# 使用方法：
#   1. 复制本文件，改名为 deploy.env（放在项目根目录）
#   2. 把下面的值换成你自己的
#   3. deploy.env 只留在你自己电脑上：不会被提交到 Git，也不会被上传到服务器
#
# 域名不在这里填：改 src/data.js 里的 DOMAIN。还是 https://example.com 时，会先用 IP 上线
# 完整说明见 DEPLOY.md
# ============================================================================

# 服务器的公网 IP（在云服务器控制台的实例详情里能看到）
DEPLOY_HOST=

# SSH 端口，一般不用改
DEPLOY_PORT=22

# 登录用户名，一般是 root
DEPLOY_USER=root

# 登录密码（在云服务器控制台设置或重置）。和下面的私钥二选一
# 密码写在两个单引号中间，比如 DEPLOY_PASSWORD='Abc#123'。不加引号的话，密码里的 # 和后面的字会被当成注释丢掉
DEPLOY_PASSWORD=''

# 用密钥登录时，填私钥文件的完整路径，比如 C:\Users\你的用户名\.ssh\id_ed25519
DEPLOY_KEY=
# 私钥有密码时填这里（同样写在单引号中间），没有就留空
DEPLOY_KEY_PASSPHRASE=''

# 申请 HTTPS 证书用的邮箱，证书出问题时 Let's Encrypt 会发邮件提醒。可以留空
DEPLOY_EMAIL=

# 要不要让联系表单在服务器上真正收留言：yes 或 no
# 填 yes 之前，先按 README「联系表单」配置好 .env（邮箱 SMTP 等）
DEPLOY_FORM=no
