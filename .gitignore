*.bak
*.bak.*
*.bak2
*.bak.a*
*.bak_*

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/

# 日志
logs/
*.log
npm-debug.log*