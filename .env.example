# ============================================================================
# 联系表单后端的配置模板（不用联系表单的话，可以完全忽略这个文件）
# ============================================================================
# 使用方法：
#   1. 复制本文件，改名为 .env（放在项目根目录）
#   2. 把下面的值换成你自己的
#   3. .env 已被 .gitignore 忽略，不会被提交到 Git
#
# ⚠️ 安全提示：SMTP_PASSWORD 和 ADMIN_PASSWORD 是密码，
#    不要贴进聊天窗口、群聊或任何 AI 对话里，也不要提交到代码仓库。
# ============================================================================

# ---------- 运行环境 ----------
NODE_ENV=development
PORT=3011
DB_PATH=./server/data/leads.db

# 网站名称，会写在通知邮件里
SITE_NAME=你的网站

# ---------- 邮件通知（有人留言时发邮件给你）----------
# 下面以阿里云企业邮箱为例；QQ 邮箱、163 邮箱等也可以，查一下对应的 SMTP 地址和端口
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
# 邮箱密码或授权码（很多邮箱需要在设置里单独生成"授权码"）
SMTP_PASSWORD=

# 留言通知发到哪个邮箱（一般就是 SMTP_USER 本身）
NOTIFY_TO=you@example.com

# ---------- 留言后台 ----------
# 访问 /admin 查看留言时需要的口令，请用一串足够长、随机的字符
# 留空则 /admin 无法登录
ADMIN_PASSWORD=

# ---------- 人机验证（Cloudflare Turnstile，可选）----------
# 留空则跳过验证。注意：中国大陆访客加载 Cloudflare 脚本可能不稳定，前端默认没有启用
TURNSTILE_SECRET=

# ---------- 频率限制 ----------
# 同一 IP 在窗口期内最多提交几次，超出返回 429
RATE_LIMIT_MAX=2
RATE_LIMIT_WINDOW_MS=10000
